# ===== 服务器部署用 .env 模板 =====
# 复制成 .env 放到服务器上 fishHelper 目录,填好后:docker compose up -d --build
# 注意:app 容器的 DATABASE_URL 由 docker-compose 自动生成(连内部 db 服务),
#       这里不用填 DATABASE_URL;下面的 POSTGRES_* 会同时用于建库和拼连接串。

# ===== 企业微信智能机器人 =====
WECOM_BOT_ID=aib_xxxxxxxxxxxxxxxx
WECOM_BOT_SECRET=your_bot_secret

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxx
# 建议 gpt-5.4(强、稳、性价比好);要更强可用 gpt-5.5/gpt-5.6-terra;省钱可 gpt-5.4-mini
OPENAI_MODEL=gpt-5.4
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Telegram(可选,与企业微信并存)=====
# 找 @BotFather 建 bot 拿 token;不填则不启用 Telegram
TELEGRAM_BOT_TOKEN=
# 白名单:逗号分隔的用户名或数字 id(不区分大小写)。留空=所有人可用。
# 例:TELEGRAM_ALLOWED=dragonbasky,friend_username,123456789
TELEGRAM_ALLOWED=

# ===== 管理员(只有这些身份能用 addCoordinate 加钓点;其余人只能查)=====
# tg 用户名 / tg 数字id / 企业微信 userid,逗号分隔
ADMINS=

# ===== 部署通知(可选)=====
# 二选一(或都填):app 启动上线后推一条"已更新+commit"消息
DEPLOY_NOTIFY_CHATID=          # 企业微信 userid(留空=不发企业微信)
DEPLOY_NOTIFY_TG_CHATID=       # Telegram 数字 chat_id(留空=不发 Telegram)

# ===== NWS(免费,只需 User-Agent)=====
NWS_USER_AGENT=fishHelper/0.1 (https://github.com/Dalles5566/fishHelper)

# ===== 专属 Postgres 容器(独立于服务器上其他 PG)=====
POSTGRES_USER=fishhelper
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=fishhelper
