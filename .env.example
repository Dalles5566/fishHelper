# ===== 服务 =====
PORT=3000

# ===== 企业微信智能机器人（API 模式 / 长连接）=====
# 管理后台 -> 安全与管理 -> 管理工具 -> 智能机器人 -> API/MCP插件 -> 使用长连接
# 机器人 Bot ID（aib_ 开头）
WECOM_BOT_ID=aib_xxxxxxxxxxxxxxxx
# 机器人 Secret（点击获取后复制）
WECOM_BOT_SECRET=your_bot_secret

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
# 如走代理/兼容网关可改，默认官方
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Stormglass（风力/潮汐）=====
# https://stormglass.io/ 注册后获取
STORMGLASS_API_KEY=your_stormglass_key

# ===== Postgres =====
# 二选一：给完整连接串，或分字段
DATABASE_URL=postgres://user:password@localhost:5432/fishhelper
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=fishhelper
