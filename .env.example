# ===== 服务 =====
PORT=3000

# ===== 企业微信智能机器人（API 模式 / 长连接）=====
# 管理后台 -> 安全与管理 -> 管理工具 -> 智能机器人 -> API/MCP插件 -> 使用长连接
WECOM_BOT_ID=aib_xxxxxxxxxxxxxxxx
WECOM_BOT_SECRET=your_bot_secret

# ===== Telegram(可选,与企业微信并存;不填则不启用)=====
# 找 @BotFather 建 bot 拿 token(long polling,无需公网 URL/域名/备案)
TELEGRAM_BOT_TOKEN=
# 白名单:逗号分隔的用户名或数字 id(不区分大小写)。留空=所有人可用。
# 例:TELEGRAM_ALLOWED=dragonbasky,friend_username,123456789
TELEGRAM_ALLOWED=

# ===== Discord(可选,与企业微信/Telegram 并存;不填则不启用)=====
# Developer Portal -> Applications -> Bot -> Token
DISCORD_BOT_TOKEN=
# 白名单:逗号分隔的 Discord 用户名或数字 user id。留空=所有人可用。
DISCORD_ALLOWED=

# ===== 管理员(只有这些身份能用 addCoordinate 加钓点;其余人只能查)=====
# tg 用户名 / tg 数字id / 企业微信 userid,逗号分隔
ADMINS=

# ===== 部署通知(可选)=====
# app 启动上线后,主动推一条"已更新+commit"消息(Telegram: DEPLOY_NOTIFY_TG_CHATID)
DEPLOY_NOTIFY_CHATID=
DEPLOY_NOTIFY_TG_CHATID=

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxx
# 主模型:analyzeFishing 出报告用(需要精确遵循长规则+数值保真)。建议 gpt-5.4。
OPENAI_MODEL=gpt-5.4
# 轻量模型(可选):agentCore 的意图提取/选工具用(结构化抽取,任务简单,可用更便宜的模型)。
# 不填则退回 OPENAI_MODEL,行为不变。想省钱可设为 gpt-5.4-mini。
OPENAI_MODEL_FAST=
# 如走代理/兼容网关可改，默认官方
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 天气/海洋数据源 =====
# 全部为免费的美国政府 API(NOAA/NWS/USGS)+ suncalc 离线库，无需 API key。
# NWS(api.weather.gov) 要求请求头带 User-Agent，标识应用与联系方式(建议放邮箱或仓库地址)。
NWS_USER_AGENT=fishHelper/0.1 (https://github.com/Dalles5566/fishHelper)

# ===== Postgres =====
# 二选一：给完整连接串，或分字段
DATABASE_URL=postgres://user:password@localhost:5432/fishhelper
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=fishhelper
